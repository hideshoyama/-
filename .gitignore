# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/app/node_modules
/app/.pnp
.pnp.*
/app/.yarn/*
!/app/.yarn/patches
!/app/.yarn/plugins
!/app/.yarn/releases
!/app/.yarn/versions

# testing
/app/coverage

# next.js
/app/.next/
/app/out/

# production
/app/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite DB files
*.db
*.db-journal
*.db-wal
*.db-shm

# data directory（実際のCSVファイルはコミットしない）
/app/data/*.csv
!/app/data/sample-musubu.csv
!/app/data/sample-urizo.csv
