generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// ナレッジ管理系
// ============================================================

// 事業者プロフィール（庄山FP事務所）- 1レコード固定
model BusinessProfile {
  id           String    @id @default(cuid())
  businessName String
  ownerName    String
  ownerTitle   String?
  description  String?
  websiteUrl   String?
  email        String?
  phone        String?
  address      String?
  foundedAt    DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("business_profiles")
}

// サービスマスタ（提供サービス一覧）
model Service {
  id               String           @id @default(cuid())
  slug             String           @unique // "hr-evaluation", "fp-consulting" など
  name             String
  shortDescription String?
  targetAudience   String?
  isActive         Boolean          @default(true)
  displayOrder     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  knowledgeItems   KnowledgeItem[]
  mailGenerations  MailGeneration[]

  @@map("services")
}

// ナレッジカテゴリ
// slug例: "overview"(概要), "merit"(メリット), "pricing"(料金),
//         "case_study"(事例), "faq"(FAQ), "profile"(実績・資格),
//         "differentiator"(差別化ポイント), "flow"(導入フロー)
model KnowledgeCategory {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  displayOrder   Int             @default(0)

  knowledgeItems KnowledgeItem[]

  @@map("knowledge_categories")
}

// ナレッジ本体（AIメール生成・チャットボット・RAGのソース）
model KnowledgeItem {
  id                 String             @id @default(cuid())
  serviceId          String?            // NULL = 事務所全体共通ナレッジ
  categoryId         String
  title              String
  content            String             // 本文（Markdown形式）
  contentSummary     String?            // 要約（AIが短く使いたい場合用）
  usageContext       String?            // "dm_email" | "chatbot" | "both"
  sourceNote         String?
  isActive           Boolean            @default(true)
  version            Int                @default(1)
  // 将来Azure AI Search RAG移行用
  embeddingModel     String?
  embeddingVector    Bytes?
  embeddingUpdatedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  service            Service?           @relation(fields: [serviceId], references: [id])
  category           KnowledgeCategory  @relation(fields: [categoryId], references: [id])
  tags               KnowledgeItemTag[]
  versions           KnowledgeVersion[]

  @@map("knowledge_items")
}

// タグマスタ
model KnowledgeTag {
  id    String             @id @default(cuid())
  name  String             @unique

  items KnowledgeItemTag[]

  @@map("knowledge_tags")
}

// ナレッジ×タグ 中間テーブル
model KnowledgeItemTag {
  knowledgeItemId String
  tagId           String

  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  tag             KnowledgeTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([knowledgeItemId, tagId])
  @@map("knowledge_item_tags")
}

// ナレッジ変更履歴
model KnowledgeVersion {
  id              String        @id @default(cuid())
  knowledgeItemId String
  version         Int
  content         String
  changedAt       DateTime      @default(now())
  changeNote      String?

  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@map("knowledge_versions")
}

// ============================================================
// 顧客DB系
// ============================================================

// 企業マスタ（1企業1レコード）
model Company {
  id                 String           @id @default(cuid())
  corporateNumber    String?          @unique // 法人番号（重複判定の最優先キー）
  name               String
  nameKana           String?
  websiteUrl         String?
  inquiryPageUrl     String?
  representativeName String?
  executiveInfo      String?
  employeeCount      Int?
  listingType        String?
  capitalAmount      BigInt?
  revenue            BigInt?
  fiscalMonth        Int?
  officeCount        Int?
  factoryCount       Int?
  storeCount         Int?
  foundedAt          DateTime?
  shortDescription   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  detail             CompanyDetail?
  offices            Office[]
  contacts           Contact[]
  jobPostings        JobPosting[]
  sources            CompanySource[]
  targetListItems    TargetListItem[]

  @@map("companies")
}

// 企業詳細（業界・事業内容など）
model CompanyDetail {
  id                String  @id @default(cuid())
  companyId         String  @unique
  mainIndustryLarge String?
  mainIndustrySmall String?
  subIndustryLarge  String?
  subIndustrySmall  String?
  businessKeywords  String? // カンマ区切り
  businessFeatures  String? // "BtoB","BtoC" 等 カンマ区切り
  companyOverview   String?

  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_details")
}

// 事業所（1企業に複数あり得る）
model Office {
  id                   String    @id @default(cuid())
  companyId            String
  officeName           String?
  officeNameKana       String?
  officeCategory1      String?
  officeCategory2      String?
  officeCategory3      String?
  addressType          String?
  postalCode           String?
  prefecture           String?
  city                 String?
  fullAddress          String?
  registeredPostalCode String?
  registeredAddress    String?
  isHeadquarters       Boolean   @default(false)

  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts             Contact[]

  @@map("offices")
}

// 連絡先（メール/電話/FAX/フォームURL）
model Contact {
  id              String           @id @default(cuid())
  companyId       String
  officeId        String?
  contactType     String           // "email" | "phone" | "fax" | "form"
  value           String
  isPrimary       Boolean          @default(false)
  label           String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  office          Office?          @relation(fields: [officeId], references: [id])
  targetListItems TargetListItem[]

  @@map("contacts")
}

// 求人情報
model JobPosting {
  id                  String    @id @default(cuid())
  companyId           String
  jobTypes            String?
  latestPostedAt      DateTime?
  estimatedAnnualCost BigInt?
  jobUrl              String?

  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("job_postings")
}

// ============================================================
// インポート系
// ============================================================

// インポートソース定義（MUSUBU/Urizo/カスタム）
model ImportSource {
  id          String          @id @default(cuid())
  name        String          // "MUSUBU" | "Urizo" | "custom"
  displayName String
  description String?
  createdAt   DateTime        @default(now())

  sessions    ImportSession[]

  @@map("import_sources")
}

// インポート実行履歴
model ImportSession {
  id             String          @id @default(cuid())
  sourceId       String
  fileName       String
  totalRows      Int
  importedRows   Int
  skippedRows    Int
  duplicateRows  Int
  status         String          // "completed" | "failed" | "partial"
  importedAt     DateTime        @default(now())
  errorLog       String?

  source         ImportSource    @relation(fields: [sourceId], references: [id])
  companySources CompanySource[]

  @@map("import_sessions")
}

// 企業×ソース紐づけ（1企業が複数ソースから来た場合の追跡）
model CompanySource {
  id              String        @id @default(cuid())
  companyId       String
  importSessionId String
  sourceRowData   String        // 元のCSV行データをJSON文字列で保存
  createdAt       DateTime      @default(now())

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importSession   ImportSession @relation(fields: [importSessionId], references: [id])

  @@map("company_sources")
}

// ============================================================
// DM送信系
// ============================================================

// 送信対象リスト
model TargetList {
  id             String           @id @default(cuid())
  name           String
  description    String?
  filterSnapshot String?          // 作成時のフィルタ条件をJSON文字列で保存
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          TargetListItem[]

  @@map("target_lists")
}

// 送信対象リストの中身
model TargetListItem {
  id          String           @id @default(cuid())
  listId      String
  companyId   String
  contactId   String?
  addedAt     DateTime         @default(now())
  // CRM拡張余地（Phase 1はNULL）
  salesStatus String?          // "lead" | "approached" | "negotiating" | "closed"
  memo        String?

  list            TargetList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id])
  contact         Contact?         @relation(fields: [contactId], references: [id])
  mailGenerations MailGeneration[]

  @@unique([listId, companyId])
  @@map("target_list_items")
}

// AI生成メール
model MailGeneration {
  id          String         @id @default(cuid())
  listItemId  String
  serviceId   String
  subject     String
  body        String
  generatedAt DateTime       @default(now())
  editedBody  String?
  isApproved  Boolean        @default(false)

  listItem    TargetListItem @relation(fields: [listItemId], references: [id], onDelete: Cascade)
  service     Service        @relation(fields: [serviceId], references: [id])
  sendLogs    SendLog[]

  @@map("mail_generations")
}

// 送信ログ
model SendLog {
  id               String         @id @default(cuid())
  mailGenerationId String
  sentAt           DateTime       @default(now())
  sentTo           String
  status           String         // "sent" | "failed" | "bounced"
  errorMessage     String?

  mailGeneration   MailGeneration @relation(fields: [mailGenerationId], references: [id])

  @@map("send_logs")
}
